<psalm
	errorLevel="2"
	findUnusedBaselineEntry="true"
	findUnusedCode="false"
	phpVersion="8.2"
	resolveFromConfigFile="true"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd">
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
			<!-- Generated by the scoping pipeline (tools/scope-vendor.php):
			     php-scoper's output under the app's namespace, not this
			     app's code to keep type-clean. It exists after every
			     composer install/update; Psalm refuses an ignore entry
			     pointing at a path that does not exist. -->
			<directory name="lib/Vendor" />
		</ignoreFiles>
	</projectFiles>
	<!-- The OCP interfaces come from the nextcloud/ocp dev dependency, not from a server checkout. -->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp" />
		<!-- Server-internal full text search models the OCP package does not ship. -->
		<directory name="tests/stubs" />
	</extraFiles>
	<issueHandlers>
		<!-- The OCP of Nextcloud 33 documents schema methods with Doctrine types the app does not ship. -->
		<UndefinedDocblockClass>
			<errorLevel type="suppress">
				<referencedClass name="Doctrine\DBAL\Platforms\AbstractPlatform" />
				<referencedClass name="Doctrine\DBAL\Schema\Schema" />
				<referencedClass name="Doctrine\DBAL\Schema\SchemaException" />
				<referencedClass name="Doctrine\DBAL\Schema\Table" />
			</errorLevel>
		</UndefinedDocblockClass>
		<!-- Psalm 6 defaults that most Nextcloud apps do not follow either. -->
		<MissingOverrideAttribute errorLevel="suppress" />
		<ClassMustBeFinal errorLevel="suppress" />
		<!-- Entity::$id is set by the mapper, not by a constructor. -->
		<PropertyNotSetInConstructor errorLevel="suppress" />
	</issueHandlers>
</psalm>
