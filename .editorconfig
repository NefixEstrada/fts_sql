# https://editorconfig.org — what the tree already looks like, written down.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.php,*.xml,*.vue,*.ts,*.js,*.mjs,*.md,Makefile}]
indent_style = tab

[*.json]
indent_style = space
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2
