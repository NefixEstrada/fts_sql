{
    "name": "nefixestrada/fts_sql",
    "description": "Full text search over the database Nextcloud already runs",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.4",
        "nextcloud/ocp": "dev-stable34",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\FtsSql\\": "lib/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --no-cache",
        "test:unit": "phpunit -c tests/phpunit.xml --testsuite unit",
        "test:integration": "phpunit -c tests/phpunit.xml --testsuite integration"
    }
}
