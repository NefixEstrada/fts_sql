{
    "name": "nefixestrada/fts_sql",
    "description": "Full text search over the database Nextcloud already runs",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "require": {
        "php": ">=8.2",
        "bamarni/composer-bin-plugin": "^1.8",
        "phpoffice/phppresentation": "^1.2",
        "phpoffice/phpword": "^1.0"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.4",
        "nextcloud/ocp": "dev-stable34",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\FtsSql\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './node_modules/*' -not -path './build/*' -not -path './lib/Vendor/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --no-cache",
        "openapi": "generate-spec --verbose && npm run typescript:generate",
        "test:unit": "phpunit -c tests/phpunit.xml --testsuite unit",
        "test:integration": "phpunit -c tests/phpunit.xml --testsuite integration",
        "test:scoping": "@php tools/scope-selftest.php",
        "post-install-cmd": [
            "@php tools/scope-vendor.php"
        ],
        "post-update-cmd": [
            "@php tools/scope-vendor.php"
        ]
    }
}
