# Spanish translations for fts_sql.
# Derived from the reviewed Catalan (translationfiles/ca/fts_sql.po), with
# the Spanish conventions the Nextcloud UI itself uses: informal tú for
# imperatives, compatible (not supported), montaje (build), analizador
# (parser), extractor de raíces (stemmer), indicador (flag).
msgid ""
msgstr ""
"Project-Id-Version: FTS SQL 1.0.0\n"
"Report-Msgid-Bugs-To: https://github.com/nefixestrada/fts_sql/issues\n"
"POT-Creation-Date: 2026-09-22 18:01+0200\n"
"PO-Revision-Date: 2026-09-22 19:30+0200\n"
"Last-Translator: Néfix Estrada <nefixestrada@gmail.com>\n"
"Language-Team: Spanish\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "FTS SQL"
msgstr "FTS SQL"

msgid "Full text search over the database Nextcloud already runs"
msgstr "Búsqueda de texto completo sobre la base de datos que Nextcloud ya utiliza"

msgid "this %s build cannot run full text search; FTS SQL will not index or answer searches"
msgstr "este montaje de %s no puede ejecutar la búsqueda de texto completo; FTS SQL no indexará ni responderá a las búsquedas"

msgid "the search artefact does not hold every document stored so far; run `occ fulltextsearch:reset && occ fulltextsearch:index`"
msgstr "el índice de búsqueda no contiene todos los documentos almacenados hasta ahora; ejecuta `occ fulltextsearch:reset && occ fulltextsearch:index`"

msgid "this %s build cannot run full text search"
msgstr "este montaje de %s no puede ejecutar la búsqueda de texto completo"

msgid "the search index artefact is missing in this database; re-enable the app or run `occ maintenance:repair`"
msgstr "falta el índice de búsqueda en esta base de datos; vuelve a habilitar la aplicación o ejecuta `occ maintenance:repair`"

msgid "the search index does not hold every document the app has stored; run `occ fulltextsearch:reset && occ fulltextsearch:index`"
msgstr "el índice de búsqueda no contiene todos los documentos que la aplicación ha almacenado; ejecuta `occ fulltextsearch:reset && occ fulltextsearch:index`"

msgid "Ready: the search index exists in this %s database"
msgstr "A punto: el índice de búsqueda existe en esta base de datos %s"

msgid "Ready"
msgstr "A punto"

msgid "Engine not supported"
msgstr "El motor no es compatible"

msgid "Engine cannot search"
msgstr "El motor no puede buscar"

msgid "Search index missing"
msgstr "Falta el índice de búsqueda"

msgid "Index incomplete"
msgstr "Índice incompleto"

msgid "encrypted"
msgstr "cifrado"

msgid "unsupported format"
msgstr "formato no compatible"

msgid "parser gave up"
msgstr "el analizador se ha rendido"

msgid "cut at the content budget"
msgstr "recortado al llegar al presupuesto de contenido"

msgid "cut at the engine's ceiling"
msgstr "recortado al llegar al límite del motor"

msgid "Documents indexed with an extraction flag"
msgstr "Documentos indexados con un indicador de extracción"

msgid "Each is findable by what was recovered; the per-document message travels on its index entry."
msgstr "Todos se pueden encontrar por lo que se ha recuperado; el mensaje de cada documento queda registrado en su entrada del índice."

msgid "Text search language"
msgstr "Lengua de la búsqueda de texto"

msgid "Changing it later invalidates every indexed document: stemmers differ per language, so a reindex is mandatory."
msgstr "Cambiarla más adelante invalida todos los documentos indexados: el extractor de raíces varía según la lengua, así que hay que volver a indexar."

msgid "Stored content per document (bytes)"
msgstr "Contenido almacenado por documento (bytes)"

msgid "The budget is bytes of extracted text, not file size. Raising it does not retro-fill documents already indexed."
msgstr "El presupuesto son bytes de texto extraído, no el tamaño del archivo. Aumentarlo no rellena los documentos ya indexados."

msgid "Save"
msgstr "Guardar"

msgid "Saved. A changed language needs occ fulltextsearch:reset && occ fulltextsearch:index."
msgstr "Guardado. Si cambias la lengua, ejecuta occ fulltextsearch:reset && occ fulltextsearch:index."

msgid "SQL full-text search"
msgstr "Búsqueda de texto completo en SQL"

msgid "Indexes and searches document content inside the database this instance already runs, with no external engine to set up."
msgstr "Indexa y busca el contenido de los documentos dentro de la base de datos que la instancia ya utiliza, sin ningún motor externo que configurar."
