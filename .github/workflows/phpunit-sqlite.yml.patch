--- a/.github/workflows/phpunit-sqlite.yml
+++ b/.github/workflows/phpunit-sqlite.yml
@@ -19,7 +19,7 @@
 
 jobs:
   changes-and-matrix:
-    runs-on: ubuntu-latest-low
+    runs-on: ubuntu-latest
     permissions:
       contents: read
       pull-requests: read
@@ -93,13 +93,21 @@
           persist-credentials: false
           path: apps/${{ env.APP_NAME }}
 
+      # The framework this app is a platform of: the integration suite uses
+      # fulltextsearch's own TestProvider, and enabling fts_sql without it
+      # installed would leave the platform unreachable.
+      - name: Checkout fulltextsearch apps
+        run: |
+          git clone --depth 1 -b ${{ matrix.server-versions }} https://github.com/nextcloud/fulltextsearch.git apps/fulltextsearch
+          git clone --depth 1 -b ${{ matrix.server-versions }} https://github.com/nextcloud/files_fulltextsearch.git apps/files_fulltextsearch
+
       - name: Set up php ${{ matrix.php-versions }}
         uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
         with:
           php-version: ${{ matrix.php-versions }}
           # https://docs.nextcloud.com/server/stable/admin_manual/installation/source_installation.html#prerequisites-for-manual-installation
           extensions: bz2, ctype, curl, dom, fileinfo, gd, iconv, intl, json, libxml, mbstring, openssl, pcntl, posix, session, simplexml, xmlreader, xmlwriter, zip, zlib, sqlite, pdo_sqlite
-          coverage: none
+          coverage: pcov
           ini-file: development
           # Temporary workaround for missing pcntl_* in PHP 8.3
           ini-values: disable_functions=
@@ -130,6 +138,12 @@
         run: |
           mkdir data
           ./occ maintenance:install --verbose --database=sqlite --database-name=nextcloud --database-host=127.0.0.1 --database-port=$DB_PORT --database-user=root --database-pass=rootpassword --admin-user admin --admin-pass admin
+          # files_external: a CLI install leaves it disabled, but the test bootstrap
+          # loads it anyway — loaded-but-unmigrated, it breaks tests that
+          # touch a real user folder.
+          ./occ app:enable files_external
+          ./occ app:enable fulltextsearch
+          ./occ app:enable files_fulltextsearch
           ./occ app:enable --force ${{ env.APP_NAME }}
 
       - name: Check PHPUnit script is defined
@@ -143,7 +157,16 @@
         # Only run if phpunit config file exists
         if: steps.check_phpunit.outcome == 'success'
         working-directory: apps/${{ env.APP_NAME }}
-        run: composer run test:unit
+        run: composer run test:unit -- --coverage-clover tests/clover.unit.xml
+
+      - name: Upload Unit coverage
+        uses: codecov/codecov-action@0b35c9ecc4f0529d0eb674914510c22f85b196b4 # v7.1.0
+        with:
+          working-directory: apps/${{ env.APP_NAME }}
+          disable_search: true
+          files: tests/clover.unit.xml
+          fail_ci_if_error: false
+          flags: unit
 
       - name: Check PHPUnit integration script is defined
         id: check_integration
@@ -161,7 +184,16 @@
         # Only run if phpunit integration config file exists
