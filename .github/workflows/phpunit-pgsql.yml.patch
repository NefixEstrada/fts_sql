--- a/.github/workflows/phpunit-pgsql.yml
+++ b/.github/workflows/phpunit-pgsql.yml
@@ -19,7 +19,7 @@
 
 jobs:
   changes-and-matrix:
-    runs-on: ubuntu-latest-low
+    runs-on: ubuntu-latest
     permissions:
       contents: read
       pull-requests: read
@@ -104,6 +104,20 @@
           persist-credentials: false
           path: apps/${{ env.APP_NAME }}
 
+      # The framework this app is a platform of: the integration suite uses
+      # fulltextsearch's own TestProvider, and enabling fts_sql without it
+      # installed would leave the platform unreachable.
+      - name: Checkout fulltextsearch apps
+        run: |
+          # fulltextsearch cuts its stableNN branches after the server cuts
+          # its own; while the branch is missing the app's default branch is
+          # that same server version (its manifest pins one minor at a time).
+          # A failed -b clone leaves nothing behind, so the fallback is safe.
+          for repo in fulltextsearch files_fulltextsearch; do
+            git clone --depth 1 -b ${{ matrix.server-versions }} "https://github.com/nextcloud/$repo.git" "apps/$repo" \
+              || git clone --depth 1 "https://github.com/nextcloud/$repo.git" "apps/$repo"
+          done
+
       - name: Set up php ${{ matrix.php-versions }}
         uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
         with:
@@ -141,6 +149,12 @@
         run: |
           mkdir data
           ./occ maintenance:install --verbose --database=pgsql --database-name=nextcloud --database-host=127.0.0.1 --database-port=$DB_PORT --database-user=root --database-pass=rootpassword --admin-user admin --admin-pass admin
+          # files_external: a CLI install leaves it disabled, but the test bootstrap
+          # loads it anyway — loaded-but-unmigrated, it breaks tests that
+          # touch a real user folder.
+          ./occ app:enable files_external
+          ./occ app:enable fulltextsearch
+          ./occ app:enable files_fulltextsearch
           ./occ app:enable --force ${{ env.APP_NAME }}
 
       - name: Check PHPUnit script is defined
@@ -189,7 +203,7 @@
   summary:
     permissions:
       contents: none
-    runs-on: ubuntu-latest-low
+    runs-on: ubuntu-latest
     needs: [changes-and-matrix, phpunit-pgsql]
 
     if: always()
